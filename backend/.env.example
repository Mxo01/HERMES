# Copy to .env and fill in. Every value here is optional — the defaults shown
# are what the server uses when the variable is absent.

# --- Server ---------------------------------------------------------------
# HOST=0.0.0.0
# PORT=5001
# DEBUG=false
# DATABASE_PATH=domotic.db
# SECRET_KEY=hermes-secret-key
# CORS_ORIGINS=*

# --- Retention ------------------------------------------------------------
# Raw samples are kept this long, then rolled up into hourly averages forever.
# DOWNSAMPLING_KEEP_DAYS=7
# DOWNSAMPLING_INTERVAL=3600

# --- Alarm thresholds -----------------------------------------------------
# GAS_ALERT_THRESHOLD=150      # MQ-2 raw ADC
# AQ_ALERT_THRESHOLD=300       # MQ-135 raw ADC
# HUMIDITY_ALERT_THRESHOLD=70  # %
# NODE_DELAYED_AFTER=90        # seconds without a reading before "delayed"
# NODE_OFFLINE_AFTER=300       # ...and before "offline"
# NODE_WATCHDOG_INTERVAL=60

# --- Telegram (alerts are skipped entirely when these are unset) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# GAS_ALERT_COOLDOWN=60        # seconds between messages for the same alarm

# --- Outdoor conditions ---------------------------------------------------
# The dashboard compares every room against the outdoors. There is no outdoor
# sensor in the BOM, so readings come from Open-Meteo (keyless, no account).
# The installation sits in Pisa; override only if it moves.
# HERMES_LATITUDE=43.7228
# HERMES_LONGITUDE=10.4017
# HERMES_LOCATION_LABEL=Pisa, Italy
# WEATHER_REFRESH_INTERVAL=900
# WEATHER_ENABLED=true         # false turns outdoor data off entirely

# --- Production ----------------------------------------------------------
# Shared secret the ESP8266 nodes must send as X-Hermes-Token. Generated by
# deploy/install.sh; unset leaves ingestion open for local development.
INGEST_TOKEN=

# Where the compiled dashboard lives. Flask serves it at the root.
# FRONTEND_DIST=../frontend/dist

# Empty means same-origin only. Set to the Vite dev server when running split.
# CORS_ORIGINS=http://localhost:5173
