#!/bin/sh
# Scan dei secret prima di ogni commit.
#
# Attivato da `make hooks` (che `make setup` chiama a sua volta): core.hooksPath
# e' configurazione per-clone, quindi ogni clone deve abilitarlo una volta.

echo "--- Secret scanning ---"

# Fail-closed: il repo e' pubblico, e il job CI gira solo dopo il push, quando
# un secret e' gia' leggibile da chiunque. Saltare lo scan deve essere una
# scelta esplicita, non l'effetto collaterale di un tool mancante.
if ! command -v gitleaks >/dev/null 2>&1; then
  if [ "${HERMES_SKIP_SECRET_SCAN:-}" = "1" ]; then
    echo "ATTENZIONE: gitleaks non installato, scan SALTATO (HERMES_SKIP_SECRET_SCAN=1)."
    exit 0
  fi
  echo ""
  echo "=============================================================="
  echo " COMMIT BLOCCATO: gitleaks non e' installato."
  echo ""
  echo " Installalo con:  brew install gitleaks"
  echo " Solo se sai cosa stai facendo, salta lo scan per un commit con:"
  echo "   HERMES_SKIP_SECRET_SCAN=1 git commit ..."
  echo "=============================================================="
  exit 1
fi

# Exit code dedicato ai leak: gitleaks esce con 1 anche per errori propri
# (config non valida, repo illeggibile), che non vanno spacciati per un secret.
LEAK_EXIT=3

# "|| STATUS=$?" evita che l'hook esca prima di stampare il messaggio.
STATUS=0
# gitleaks >= 8.19 usa "git --staged"; le versioni precedenti "protect --staged"
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner --exit-code "$LEAK_EXIT" --config .gitleaks.toml || STATUS=$?
else
  gitleaks protect --staged --redact --no-banner --exit-code "$LEAK_EXIT" --config .gitleaks.toml || STATUS=$?
fi

if [ "$STATUS" -eq "$LEAK_EXIT" ]; then
  echo ""
  echo "=============================================================="
  echo " COMMIT BLOCCATO: possibile secret nei file staged."
  echo ""
  echo " Sposta il valore in backend/.env (gitignored) o in una env var,"
  echo " e lascia il placeholder nel file committato."
  echo " Vedi backend/.env.example per le chiavi."
  echo ""
  echo " Nel firmware, DEVICE_TOKEN va lasciato \"\" nel file committato:"
  echo " il token vero si mette solo nella copia locale prima del flash."
  echo ""
  echo " Falso positivo? Aggiungilo alla allowlist in .gitleaks.toml."
  echo " NON usare --no-verify per aggirare questo controllo."
  echo "=============================================================="
  exit 1
fi

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "=============================================================="
  echo " COMMIT BLOCCATO: gitleaks e' fallito (exit $STATUS), lo scan"
  echo " non e' stato completato. Non e' stato trovato un secret: leggi"
  echo " l'errore qui sopra, di solito e' .gitleaks.toml non valido"
  echo " (gitleaks usa RE2: niente lookahead/lookbehind)."
  echo "=============================================================="
  exit 1
fi

exit 0
